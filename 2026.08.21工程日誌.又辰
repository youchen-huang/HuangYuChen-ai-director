// 告訴電腦：紅燈接在 25 號腳位，藍燈接在 26 號腳位
const int RED_LED = 25;
const int BLUE_LED = 26;

void setup() {
  // 設定這兩個腳位是用來控制燈光的 (輸出)
  pinMode(RED_LED, OUTPUT);
  pinMode(BLUE_LED, OUTPUT);
}

void loop() {
  // 1. 先安靜等待 2 秒 (2000 毫秒 = 2 秒)
  delay(2000);
  
  // 2. 紅燈「閃現」一下 (亮 0.1 秒後立刻關掉)
  digitalWrite(RED_LED, HIGH); // 紅燈亮
  delay(100);                  // 等待 0.1 秒
  digitalWrite(RED_LED, LOW);  // 紅燈滅

  // 3. 藍燈亮起，並持續閃爍亮 2 秒
  digitalWrite(BLUE_LED, HIGH); // 藍燈亮
  delay(2000);                  // 亮著持續 2 秒
  digitalWrite(BLUE_LED, LOW);  // 藍燈滅
  
  // 程式會自動回到最上面，一直無限重複！
}

